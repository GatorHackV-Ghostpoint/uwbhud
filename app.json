{
  "expo": {
    "name": "uwbhud",
    "slug": "uwbhud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jacklowry.uwbhud",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Shows nearby people on the camera view",
        "NSNearbyInteractionUsageDescription": "Measures distance and direction to nearby phones",
        "NSLocalNetworkUsageDescription": "Finds nearby phones running UWBHud",
        "NSBonjourServices": ["_uwbhud._tcp", "_uwbhud._udp"],
        "UIRequiredDeviceCapabilities": ["arkit"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" } }]
    ]
  }
}